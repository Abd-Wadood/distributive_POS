{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Offline_POS;Username=postgres;Password=123"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "PosOperations": {
    "SessionStaleTimeout": "00:05:00",
    "HeartbeatWriteInterval": "00:00:30",
    "TerminalOfflineThreshold": "00:02:00",
    "TerminalCookieExpiration": "180.00:00:00",
    "RequireSecureTerminalCookieInProduction": true,
    "AllowSessionResumeFromDifferentTerminal": false,
    "SessionCashDifferenceApprovalThreshold": 100,
    "MinimumSessionDurationBeforeClose": "00:05:00"
  },

  "Dashboard": {
    "CacheSeconds": 30,
    "TerminalOnlineSeconds": 60,
    "TerminalStaleSeconds": 300,
    "MaxRecentSessions": 10,
    "MaxAlerts": 10,
    "MaxInventoryRisks": 10,
    "MaxTerminals": 10
  },

  "SecurityRateLimits": {
    "LoginIpPermitLimit": 20,
    "LoginFailedPermitLimit": 5,
    "LoginIpFailedPermitLimit": 25,
    "OrderFinalizePermitLimit": 2,
    "ProductSearchPermitLimit": 20,
    "SessionStartPermitLimit": 3,
    "TerminalHeartbeatPermitLimit": 2,
    "ReportsPermitLimit": 10,
    "WindowSeconds": 60,
    "OrderFinalizeWindowSeconds": 1,
    "HeartbeatWindowSeconds": 30,
    "MaxReportPageSize": 200,
    "DefaultReportPageSize": 100,
    "MaxProductSearchResults": 50,
    "ProductSearchMinimumLength": 2
  },

  "RequestLimits": {
    "MaxRequestBodyBytes": 1048576,
    "MaxFormBytes": 65536,
    "MaxFormValueLength": 16384,
    "DefaultTimeoutSeconds": 20,
    "RequestHeadersTimeoutSeconds": 15,
    "KeepAliveTimeoutSeconds": 60
  },

  "Idempotency": {
    "RetentionDays": 14
  },

  "AllowedHosts": "*"
}
