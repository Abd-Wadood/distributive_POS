@model BranchPOS.Models.OperationalExpense
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "New Operational Expense";
    var categories = (IEnumerable<SelectListItem>)ViewBag.Categories;
}

<h1>New Operational Expense</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="ExpenseCategoryId" class="form-label">Category</label>
            <select asp-for="ExpenseCategoryId" asp-items="categories" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-3">
            <label asp-for="ExpenseDate" class="form-label">Date</label>
            <input asp-for="ExpenseDate" class="form-control" type="date" />
        </div>
    </div>
    <div class="mt-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Save expense</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
