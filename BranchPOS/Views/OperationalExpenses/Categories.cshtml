@model IEnumerable<BranchPOS.Models.ExpenseCategory>
@{
    ViewData["Title"] = "Expense Categories";
}

<h1>Expense Categories</h1>
<form asp-action="CreateCategory" method="post" class="row g-2 mb-3">
    <div class="col-md-5"><input name="Name" class="form-control" placeholder="Category name" /></div>
    <div class="col-md-2"><button class="btn btn-primary" type="submit">Add</button></div>
</form>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var category in Model)
    {
        <tr><td>@category.Name</td><td>@(category.IsActive ? "Active" : "Inactive")</td></tr>
    }
    </tbody>
</table>
