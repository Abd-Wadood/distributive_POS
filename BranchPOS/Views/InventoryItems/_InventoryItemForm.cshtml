@model BranchPOS.Models.InventoryItem
@using System.Text.Json
@using BranchPOS.Models
@using BranchPOS.Services
@{
    var baseUnits = (IEnumerable<string>?)ViewBag.BaseUnits ?? InventoryUnitCatalog.SupportedBaseUnits;
    var unitOptions = (IEnumerable<InventoryUnitOption>?)ViewBag.UnitOptions ?? InventoryUnitCatalog.GetOptions();
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-5">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="BaseUnit" class="form-label">Base unit</label>
            <select asp-for="BaseUnit" class="form-select" id="baseUnitSelect">
                @foreach (var unit in baseUnits)
                {
                    <option value="@unit">@unit</option>
                }
            </select>
            <span asp-validation-for="BaseUnit" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="PurchaseUnitName" class="form-label">Default purchase unit</label>
            <select asp-for="PurchaseUnitName" class="form-select" id="purchaseUnitSelect">
                <option value="">Select unit</option>
            </select>
            <span asp-validation-for="PurchaseUnitName" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="DefaultConversionFactorToBase" class="form-label">Default conversion</label>
            <input asp-for="DefaultConversionFactorToBase" class="form-control" type="number" step="0.001" id="conversionInput" />
            <div class="form-text" id="conversionHelp"></div>
            <span asp-validation-for="DefaultConversionFactorToBase" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="ReorderLevel" class="form-label">Reorder level (base)</label>
            <input asp-for="ReorderLevel" class="form-control" type="number" step="0.001" />
            <span asp-validation-for="ReorderLevel" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsStockTracked" class="form-check-input" />
                <label asp-for="IsStockTracked" class="form-check-label">Stock tracked</label>
            </div>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

<script>
    (() => {
        const unitOptions = @Html.Raw(JsonSerializer.Serialize(unitOptions.Select(x => new
        {
            x.DisplayName,
            x.CompatibleBaseUnit,
            x.DefaultConversionFactorToBase,
            x.RequiresCustomConversion,
            x.IsFixedConversion
        })));
        const baseUnit = document.getElementById('baseUnitSelect');
        const purchaseUnit = document.getElementById('purchaseUnitSelect');
        const conversion = document.getElementById('conversionInput');
        const help = document.getElementById('conversionHelp');
        const initialPurchaseUnit = '@(Model.PurchaseUnitName ?? string.Empty)';

        const syncPurchaseUnits = (preferredValue) => {
            const compatible = unitOptions.filter(x => x.CompatibleBaseUnit === baseUnit.value);
            const current = preferredValue ?? purchaseUnit.value;
            purchaseUnit.innerHTML = '<option value="">Select unit</option>';
            for (const option of compatible) {
                const element = document.createElement('option');
                element.value = option.DisplayName;
                element.textContent = option.DisplayName;
                purchaseUnit.appendChild(element);
            }

            const stillValid = compatible.some(x => x.DisplayName === current);
            purchaseUnit.value = stillValid ? current : '';
            if (!stillValid) {
                conversion.value = '';
            }
            syncConversion();
        };

        const syncConversion = () => {
            const selected = unitOptions.find(x => x.CompatibleBaseUnit === baseUnit.value && x.DisplayName === purchaseUnit.value);
            if (!selected) {
                conversion.value = '';
                conversion.readOnly = false;
                help.textContent = '';
                return;
            }

            if (selected.IsFixedConversion) {
                conversion.value = selected.DefaultConversionFactorToBase;
                conversion.readOnly = true;
            } else {
                conversion.readOnly = false;
            }

            help.textContent = conversion.value
                ? `1 ${selected.DisplayName} = ${conversion.value} ${baseUnit.value}`
                : `Enter how many ${baseUnit.value} are in 1 ${selected.DisplayName}`;
        };

        baseUnit?.addEventListener('change', () => syncPurchaseUnits(null));
        purchaseUnit?.addEventListener('change', syncConversion);
        conversion?.addEventListener('input', syncConversion);
        syncPurchaseUnits(initialPurchaseUnit);
    })();
</script>
