@model IEnumerable<BranchPOS.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventory Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Inventory Items</h1>
    <a class="btn btn-primary" asp-action="Create">New item</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Base unit</th><th>Purchase unit</th><th>Conversion</th><th>Reorder level</th><th>Type</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.BaseUnit</td>
            <td>@item.PurchaseUnitName</td>
            <td>@item.DefaultConversionFactorToBase?.ToString("0.###")</td>
            <td>@item.ReorderLevel</td>
            <td>@(item.IsPreparedItem ? "Prepared" : "Purchased")</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                @if (item.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Deactivate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
