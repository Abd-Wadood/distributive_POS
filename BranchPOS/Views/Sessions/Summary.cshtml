@model BranchPOS.ViewModels.SessionSummaryViewModel
@{
    ViewData["Title"] = "Session summary";
}

<h1>Session summary</h1>
<dl class="row">
    <dt class="col-sm-3">Session</dt><dd class="col-sm-9">@Model.Session.SessionCode</dd>
    <dt class="col-sm-3">Branch</dt><dd class="col-sm-9">@Model.Session.Branch?.Name</dd>
    <dt class="col-sm-3">User</dt><dd class="col-sm-9">@Model.Session.User?.Email</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Session.Status</dd>
    <dt class="col-sm-3">Started</dt><dd class="col-sm-9">@Model.Session.StartedAt.ToLocalTime()</dd>
    <dt class="col-sm-3">Ended</dt><dd class="col-sm-9">@Model.Session.EndedAt?.ToLocalTime()</dd>
    <dt class="col-sm-3">Opening cash</dt><dd class="col-sm-9">@Model.Session.OpeningCashAmount.ToString("0.00")</dd>
    <dt class="col-sm-3">Expected closing cash</dt><dd class="col-sm-9">@Model.ExpectedClosingCash.ToString("0.00")</dd>
    <dt class="col-sm-3">Counted closing cash</dt><dd class="col-sm-9">@Model.CountedClosingCash?.ToString("0.00")</dd>
    <dt class="col-sm-3">Cash difference</dt><dd class="col-sm-9">@Model.CashDifference?.ToString("0.00")</dd>
</dl>

<div class="row g-3">
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Completed orders</h6><strong>@Model.CompletedOrdersCount</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Total sales</h6><strong>@Model.TotalSalesAmount.ToString("0.00")</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Cancelled orders</h6><strong>@Model.CancelledOrdersCount</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Draft orders</h6><strong>@Model.ActiveDraftOrdersCount</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Purchases</h6><strong>@Model.PurchasesCount</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Purchase total</h6><strong>@Model.TotalPurchaseAmount.ToString("0.00")</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Adjustments</h6><strong>@Model.InventoryAdjustmentsCount</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body"><h6>Low stock warnings</h6><strong>@Model.LowStockWarnings</strong></div></div></div>
</div>

@if ((User.IsInRole("Admin") || User.IsInRole("StockManager")) &&
    (Model.Session.Status == BranchPOS.Models.SessionStatus.Closed || Model.Session.Status == BranchPOS.Models.SessionStatus.ForceClosed))
{
    <form asp-action="Reopen" method="post" class="card mt-3">
        <div class="card-body">
            <h5>Reopen last closed session / shift</h5>
            <input type="hidden" name="sessionId" value="@Model.Session.Id" />
            <label class="form-label" for="reason">Reason</label>
            <input class="form-control" id="reason" name="reason" required maxlength="500" />
            <button class="btn btn-warning mt-3" type="submit">Reopen session / shift</button>
        </div>
    </form>
}
