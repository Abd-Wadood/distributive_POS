@model BranchPOS.ViewModels.SessionStartViewModel
@{
    ViewData["Title"] = "Session / Shift";
    var canViewSummary = User.IsInRole("Admin");
}

<h1>Session / Shift</h1>
@if (!Model.CanStartSession && Model.ActiveSession is null)
{
    <div class="alert alert-warning">
        @Model.StartSessionBlockReason
        <div class="mt-2">
            Use a terminal code assigned to this user's branch, or edit the user's branch assignment from Admin > Users.
        </div>
    </div>
}

@if (Model.ActiveSession is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>Active session / shift @Model.ActiveSession.SessionCode</h5>
            <p class="mb-1">Branch: @Model.ActiveSession.Branch?.Name</p>
            <p class="mb-1">Terminal: @Model.ActiveSession.TerminalName (@Model.ActiveSession.TerminalCode)</p>
            <p class="mb-1">Started: @Model.ActiveSession.StartedAt.ToLocalTime()</p>
            <p class="mb-1">Opening cash: @CurrencyFormatter.Format(Model.ActiveSession.OpeningCashAmount)</p>
            <div class="d-flex gap-2 mt-3">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Continue session / shift</a>
                @if (canViewSummary)
                {
                    <a class="btn btn-outline-secondary" asp-action="Summary" asp-route-id="@Model.ActiveSession.Id">View summary</a>
                }
                <a class="btn btn-danger" asp-action="Close" asp-route-sessionId="@Model.ActiveSession.Id">Close session / shift</a>
            </div>
        </div>
    </div>
}

@if (Model.AbandonedSession is not null)
{
    <div class="card mb-3 border-warning">
        <div class="card-body">
            <h5>Abandoned session / shift @Model.AbandonedSession.SessionCode</h5>
            <p class="mb-1">Branch: @Model.AbandonedSession.Branch?.Name</p>
            <form asp-action="Continue" method="post">
                <input type="hidden" name="sessionId" value="@Model.AbandonedSession.Id" />
                <button class="btn btn-warning" type="submit">Resume abandoned session / shift</button>
            </form>
        </div>
    </div>
}

@if (Model.ActiveSession is null)
{
    <form asp-action="Start" method="post" class="card" id="startSessionForm">
        <div class="card-body">
            <input type="hidden" asp-for="IdempotencyKey" />
            <h5>Start session / shift</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="BranchId" class="form-label"></label>
                    <input class="form-control" value="@Model.TerminalBranchName" readonly />
                    <input type="hidden" asp-for="BranchId" />
                </div>
                <div class="col-md-4">
                    <label asp-for="RoleName" class="form-label"></label>
                    <input asp-for="RoleName" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="TerminalCode" class="form-label"></label>
                    <input asp-for="TerminalCode" class="form-control" readonly />
                </div>
                <div class="col-md-8">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="OpeningCashAmount" class="form-label">Opening cash</label>
                    <input asp-for="OpeningCashAmount" class="form-control" type="number" min="0" step="0.01" required />
                    <span asp-validation-for="OpeningCashAmount" class="text-danger"></span>
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit" id="startSessionButton" disabled="@(!Model.CanStartSession)">Start session / shift</button>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.getElementById('startSessionForm')?.addEventListener('submit', function () {
            const button = document.getElementById('startSessionButton');
            if (button) {
                button.disabled = true;
                button.textContent = 'Starting session / shift...';
            }
        });
    </script>
}
