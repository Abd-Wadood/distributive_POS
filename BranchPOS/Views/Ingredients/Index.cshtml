@model IEnumerable<BranchPOS.Models.Ingredient>
@{
    ViewData["Title"] = "Ingredients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ingredients</h1>
    <a class="btn btn-primary" asp-action="Create">New ingredient</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Unit</th><th>Minimum</th><th>Current stock</th><th></th></tr></thead>
    <tbody>
    @foreach (var ingredient in Model)
    {
        <tr>
            <td>@ingredient.Name</td>
            <td>@ingredient.UnitType</td>
            <td>@ingredient.MinimumStockLevel</td>
            <td>@(ingredient.Inventory?.CurrentQuantity ?? 0)</td>
            <td><a asp-action="Edit" asp-route-id="@ingredient.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
