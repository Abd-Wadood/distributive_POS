@model IEnumerable<BranchPOS.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Suppliers</h1>
    <a class="btn btn-primary" asp-action="Create">New supplier</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var supplier in Model)
    {
        <tr>
            <td>@supplier.Name</td>
            <td>@(supplier.Phone ?? "-")</td>
            <td>@supplier.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
            <td class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@supplier.Id">Edit</a>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this supplier?');">
                    <input type="hidden" name="id" value="@supplier.Id" />
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-muted">No suppliers have been added yet.</td></tr>
    }
    </tbody>
</table>
