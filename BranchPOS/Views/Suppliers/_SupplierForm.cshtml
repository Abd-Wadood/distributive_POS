@model BranchPOS.Models.Supplier

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label">Supplier name</label>
    <input asp-for="Name" class="form-control" maxlength="160" autocomplete="organization" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" maxlength="40" autocomplete="tel" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>
