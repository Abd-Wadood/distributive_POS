@model IEnumerable<BranchPOS.Models.Inventory>
@{
    ViewData["Title"] = "Inventory";
}

<h1>Inventory</h1>

<table class="table table-striped">
    <thead><tr><th>Ingredient</th><th>Current quantity</th><th>Minimum</th><th>Adjustment</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Ingredient?.Name (@item.Ingredient?.UnitType)</td>
            <td>@item.CurrentQuantity</td>
            <td>@item.Ingredient?.MinimumStockLevel</td>
            <td>
                <form asp-action="Adjust" method="post" class="d-flex gap-2">
                    <input type="hidden" name="IdempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                    <input type="hidden" name="IngredientId" value="@item.IngredientId" />
                    <input class="form-control" name="QuantityChanged" type="number" step="0.001" />
                    <button class="btn btn-sm btn-outline-primary" type="submit">Apply</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
