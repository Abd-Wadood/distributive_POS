@model IEnumerable<BranchPOS.Models.Recipe>
@{
    ViewData["Title"] = "Recipe Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Recipe Management</h1>
    <a class="btn btn-primary" asp-action="Edit">Assign recipe</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Product</th><th>Ingredients</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var recipe in Model)
    {
        <tr>
            <td>@recipe.Product?.Name</td>
            <td>@string.Join(", ", recipe.Ingredients.Select(x => $"{x.InventoryItem?.Name} {x.QuantityRequiredBase:0.###} {x.InventoryItem?.BaseUnit}"))</td>
            <td>@(recipe.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-productId="@recipe.ProductId">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
