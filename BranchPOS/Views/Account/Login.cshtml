@model BranchPOS.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
    var terminalSetupUrl = Url.Action("Index", "TerminalSetup", new { returnUrl = Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl }) });
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - BranchPOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            background: #f4f6f8;
        }

        .login-shell {
            min-height: 100vh;
        }

        .login-card {
            border: 0;
            border-radius: 1rem;
            box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, .12);
        }

        .brand-mark {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #0d6efd;
            color: #fff;
            font-weight: 700;
            letter-spacing: 0;
        }

        .validation-summary-valid {
            display: none;
        }
    </style>
</head>
<body>
    <main class="login-shell d-flex align-items-center py-4">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-7 col-lg-5 col-xl-4">
                    <div class="text-center mb-4">
                        <div class="brand-mark mb-3">BP</div>
                        <h1 class="h3 mb-1">BranchPOS</h1>
                        <p class="text-muted mb-0">Offline-First Branch POS System</p>
                    </div>

                    <div class="card login-card">
                        <div class="card-body p-4 p-md-5">
                            @if (Model.HasRegisteredTerminal)
                            {
                                <div class="alert alert-light border d-flex justify-content-between align-items-start gap-3 mb-4">
                                    <div>
                                        <div class="small text-muted">Current terminal</div>
                                        <div class="fw-semibold">@Model.TerminalName</div>
                                        <div class="small text-muted">@Model.TerminalCode · @Model.TerminalBranchName</div>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary" href="@terminalSetupUrl">Change</a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-4">
                                    <div class="fw-semibold">Terminal setup required</div>
                                    <div class="small mb-3">Cashier and stock sessions require this browser to be registered to a terminal.</div>
                                    <a class="btn btn-sm btn-warning" href="@terminalSetupUrl">Setup Terminal</a>
                                </div>
                            }

                            <form asp-action="Login" method="post">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" autofocus />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label"></label>
                                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" />
                                        <label asp-for="RememberMe" class="form-check-label"></label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
                            </form>
                        </div>
                    </div>

                    <p class="text-center text-muted small mt-4 mb-0">
                        Use your assigned role account. Contact an administrator if your branch or terminal is unavailable.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
