@model BranchPOS.ViewModels.ProfitReportViewModel
@{
    ViewData["Title"] = "Profit Report";
}

<h1>Profit Report</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
    <div class="col-md-3"><input name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
    <div class="col-md-2"><button class="btn btn-outline-primary" type="submit">Filter</button></div>
</form>

<table class="table table-striped w-auto">
    <tbody>
        <tr><th>Sales Revenue</th><td>@CurrencyFormatter.Format(Model.SalesRevenue)</td></tr>
        <tr><th>Ingredient Cost</th><td>@CurrencyFormatter.Format(Model.IngredientCost)</td></tr>
        <tr><th>Inventory Loss / Wastage</th><td>@CurrencyFormatter.Format(Model.InventoryLoss)</td></tr>
        <tr><th>Operational Expenses</th><td>@CurrencyFormatter.Format(Model.OperationalExpenses)</td></tr>
        <tr><th>Net Profit</th><td>@CurrencyFormatter.Format(Model.NetProfit)</td></tr>
    </tbody>
</table>

<h2 class="h5 mt-4">Inventory Loss Breakdown</h2>
<table class="table table-sm table-striped w-auto">
    <tbody>
        <tr><th>Stock Room Waste Cost</th><td>@CurrencyFormatter.Format(Model.StockRoomWasteCost)</td></tr>
        <tr><th>Kitchen Waste Cost</th><td>@CurrencyFormatter.Format(Model.KitchenWasteCost)</td></tr>
        <tr><th>Missing Stock Cost</th><td>@CurrencyFormatter.Format(Model.MissingStockCost)</td></tr>
        <tr><th>Expired Stock Cost</th><td>@CurrencyFormatter.Format(Model.ExpiredStockCost)</td></tr>
        <tr><th>Damaged Stock Cost</th><td>@CurrencyFormatter.Format(Model.DamagedStockCost)</td></tr>
        <tr><th>Spillage Cost</th><td>@CurrencyFormatter.Format(Model.SpillageCost)</td></tr>
        <tr><th>Correction Increase Total</th><td>@CurrencyFormatter.Format(Model.CorrectionIncreaseTotal)</td></tr>
        <tr><th>Correction Decrease Total</th><td>@CurrencyFormatter.Format(Model.CorrectionDecreaseTotal)</td></tr>
    </tbody>
</table>
