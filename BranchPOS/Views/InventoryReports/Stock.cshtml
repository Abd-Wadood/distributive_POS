@model IEnumerable<BranchPOS.Models.InventoryStock>
@{
    ViewData["Title"] = "Inventory Stock";
}

<h1>@ViewData["Title"]</h1>
<table class="table table-striped">
    <thead><tr><th>Item</th><th>Base unit</th><th>On hand</th><th>Reserved</th><th>Available</th><th>Display</th><th>Reorder level</th><th>Average base cost</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var stock in Model)
    {
        var available = stock.QuantityBase - stock.ReservedQuantityBase;
        var low = available <= stock.InventoryItem?.ReorderLevel;
        var display = stock.InventoryItem?.BaseUnit == "Gram" && available >= 1000
            ? $"{available / 1000:0.###} kg"
            : stock.InventoryItem?.BaseUnit == "ML" && available >= 1000
                ? $"{available / 1000:0.###} L"
                : $"{available:0.###} {stock.InventoryItem?.BaseUnit?.ToLowerInvariant()}";
        <tr class="@(low ? "table-warning" : "")">
            <td>@stock.InventoryItem?.Name</td>
            <td>@stock.InventoryItem?.BaseUnit</td>
            <td>@stock.QuantityBase.ToString("0.###")</td>
            <td>@stock.ReservedQuantityBase.ToString("0.###")</td>
            <td>@available.ToString("0.###")</td>
            <td>@display</td>
            <td>@stock.InventoryItem?.ReorderLevel.ToString("0.###")</td>
            <td>@stock.AverageUnitCostBase.ToString("0.######")</td>
            <td>@(low ? "Low" : "OK")</td>
        </tr>
    }
    </tbody>
</table>
