@model BranchPOS.DTOs.CreateManualKitchenUsageDto
@using BranchPOS.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Manual Kitchen Usage";
    var items = (IEnumerable<SelectListItem>)ViewBag.InventoryItems;
    var recentUsages = (IEnumerable<ManualKitchenUsage>?)ViewBag.RecentUsages ?? [];
}

<h1>Manual Kitchen Usage</h1>

<form asp-action="Create" method="post" class="mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-2">
            <label asp-for="UsageDate" class="form-label">Date</label>
            <input asp-for="UsageDate" class="form-control" type="date" />
            <span asp-validation-for="UsageDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="InventoryItemId" class="form-label">Item</label>
            <select asp-for="InventoryItemId" asp-items="items" class="form-select">
                <option value="">Select item</option>
            </select>
            <span asp-validation-for="InventoryItemId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="OpeningKitchenQuantity" class="form-label">Opening</label>
            <input asp-for="OpeningKitchenQuantity" class="form-control usage-number" type="number" step="0.001" />
        </div>
        <div class="col-md-2">
            <label asp-for="ReceivedFromStockRoomQuantity" class="form-label">Received</label>
            <input asp-for="ReceivedFromStockRoomQuantity" class="form-control usage-number" type="number" step="0.001" />
        </div>
        <div class="col-md-2">
            <label asp-for="ClosingKitchenQuantity" class="form-label">Closing</label>
            <input asp-for="ClosingKitchenQuantity" class="form-control usage-number" type="number" step="0.001" />
        </div>
        <div class="col-md-5">
            <label asp-for="Notes" class="form-label">Notes</label>
            <input asp-for="Notes" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Save usage</button>
    </div>
</form>

<h2 class="h4">Recent usage</h2>
<table class="table table-sm align-middle">
    <thead>
    <tr>
        <th>Date</th>
        <th>Item</th>
        <th class="text-end">Opening</th>
        <th class="text-end">Received</th>
        <th class="text-end">Closing</th>
        <th class="text-end">Used</th>
        <th>Notes</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var usage in recentUsages)
    {
        <tr>
            <td>@usage.UsageDate.ToString("yyyy-MM-dd")</td>
            <td>@usage.InventoryItem?.Name</td>
            <td class="text-end">@usage.OpeningKitchenQuantity.ToString("0.###")</td>
            <td class="text-end">@usage.ReceivedFromStockRoomQuantity.ToString("0.###")</td>
            <td class="text-end">@usage.ClosingKitchenQuantity.ToString("0.###")</td>
            <td class="text-end">@usage.ActualUsedQuantity.ToString("0.###")</td>
            <td>@usage.Notes</td>
        </tr>
    }
    </tbody>
</table>
