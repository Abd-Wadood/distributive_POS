@model IEnumerable<BranchPOS.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("StockManager"))
    {
        <a class="btn btn-primary" asp-action="Create">New product</a>
    }
</div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Ingredients</th><th></th></tr></thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Category?.Name</td>
            <td>@product.Price.ToString("0.00")</td>
            <td>@string.Join(", ", product.ProductIngredients.Select(x => $"{x.Ingredient?.Name}: {x.QuantityRequired:0.###}"))</td>
            <td>
                @if (User.IsInRole("Admin") || User.IsInRole("StockManager"))
                {
                    <a asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
