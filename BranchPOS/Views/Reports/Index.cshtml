@model BranchPOS.ViewModels.ReportingViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <div>
        <h1 class="mb-1">Reports</h1>
        <p class="text-muted mb-0">Temporary admin-only data view for testing.</p>
    </div>
    <span class="badge text-bg-secondary">@Model.Tables.Sum(x => x.RowCount) rows</span>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-2">
        <label class="form-label" for="pageSize">Page size</label>
        <input id="pageSize" name="pageSize" class="form-control" type="number" min="1" max="200" value="@Model.PageSize" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="from">From</label>
        <input id="from" name="from" class="form-control" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="to">To</label>
        <input id="to" name="to" class="form-control" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" type="submit">Apply</button>
    </div>
</form>

<div class="accordion" id="reportTables">
    @for (var tableIndex = 0; tableIndex < Model.Tables.Count; tableIndex++)
    {
        var table = Model.Tables[tableIndex];
        var headingId = $"report-heading-{tableIndex}";
        var panelId = $"report-panel-{tableIndex}";

        <div class="accordion-item">
            <h2 class="accordion-header" id="@headingId">
                <button class="accordion-button @(tableIndex == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@panelId" aria-expanded="@(tableIndex == 0 ? "true" : "false")" aria-controls="@panelId">
                    <span class="fw-semibold">@table.Name</span>
                    <span class="badge text-bg-light border ms-2">@table.RowCount rows</span>
                </button>
            </h2>
            <div id="@panelId" class="accordion-collapse collapse @(tableIndex == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#reportTables">
                <div class="accordion-body p-0">
                    @if (table.Rows.Count == 0)
                    {
                        <div class="p-3 text-muted">No data saved.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        @foreach (var column in table.Columns)
                                        {
                                            <th scope="col">@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in table.Rows)
                                    {
                                        <tr>
                                            @foreach (var value in row)
                                            {
                                                <td class="text-nowrap">@value</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
