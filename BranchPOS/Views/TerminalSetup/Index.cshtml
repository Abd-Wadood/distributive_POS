@model BranchPOS.ViewModels.TerminalSetupViewModel
@{
    ViewData["Title"] = "Terminal setup";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <form asp-action="Save" method="post" class="card">
            <div class="card-body">
                <h1 class="h3">Terminal setup</h1>
                <p class="text-muted">Choose the code for this physical cashier computer. It will be saved in this browser.</p>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="TerminalCode" class="form-label"></label>
                    <input asp-for="TerminalCode" class="form-control" list="terminalCodes" autocomplete="off" />
                    <span asp-validation-for="TerminalCode" class="text-danger"></span>
                    <datalist id="terminalCodes">
                        @foreach (var terminal in Model.Terminals)
                        {
                            <option value="@terminal.TerminalCode">@terminal.Name - @terminal.Branch?.Name</option>
                        }
                    </datalist>
                </div>

                <button class="btn btn-primary" type="submit">Save terminal</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('TerminalCode');
        const savedCode = localStorage.getItem('BranchPOS.TerminalCode');
        if (input && savedCode && !input.value) {
            input.value = savedCode;
        }
        document.querySelector('form')?.addEventListener('submit', () => {
            if (input?.value) {
                localStorage.setItem('BranchPOS.TerminalCode', input.value.trim().toUpperCase());
            }
        });
    </script>
}
