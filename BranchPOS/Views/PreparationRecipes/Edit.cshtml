@model BranchPOS.Models.PreparationRecipe
@using BranchPOS.Models
@{
    ViewData["Title"] = "Edit Preparation Recipe";
    var inventoryItems = (IEnumerable<InventoryItem>?)ViewBag.InventoryItemModels ?? [];
}

<h1>Edit Preparation Recipe</h1>
<form method="post" id="preparationRecipeForm">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label">Recipe name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="OutputInventoryItemId" class="form-label">Output inventory item</label>
            <select asp-for="OutputInventoryItemId" class="form-select" id="outputItemSelect">
                <option value="">Select item</option>
                @foreach (var item in inventoryItems)
                {
                    <option value="@item.Id" selected="@(Model.OutputInventoryItemId == item.Id)" data-base-unit="@item.BaseUnit" data-is-prepared="@item.IsPreparedItem.ToString().ToLowerInvariant()">@item.Name (@item.BaseUnit)</option>
                }
            </select>
            <div class="form-text" id="outputPreparedWarning"></div>
            <span asp-validation-for="OutputInventoryItemId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="OutputQuantityBase" class="form-label">Output quantity</label>
            <input asp-for="OutputQuantityBase" class="form-control" type="number" step="0.001" />
            <div class="form-text">Unit: <span id="outputUnitLabel"></span></div>
            <span asp-validation-for="OutputQuantityBase" class="text-danger"></span>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
        </div>
    </div>

    <h2 class="h4">Input ingredients</h2>
    <table class="table align-middle">
        <thead><tr><th>Input item</th><th>Required quantity</th><th>Unit</th><th></th></tr></thead>
        <tbody id="ingredientRows">
        @for (var i = 0; i < Model.Ingredients.Count; i++)
        {
            <tr class="ingredient-row">
                <td>
                    <select name="Ingredients[@i].InventoryItemId" class="form-select inventory-item-select">
                        <option value="">Select item</option>
                        @foreach (var item in inventoryItems)
                        {
                            <option value="@item.Id" selected="@(Model.Ingredients[i].InventoryItemId == item.Id)" data-base-unit="@item.BaseUnit">@item.Name (@item.BaseUnit)</option>
                        }
                    </select>
                    <span asp-validation-for="Ingredients[i].InventoryItemId" class="text-danger"></span>
                </td>
                <td>
                    <input name="Ingredients[@i].QuantityBase" value="@Model.Ingredients[i].QuantityBase" class="form-control quantity-input" type="number" step="0.001" />
                    <span asp-validation-for="Ingredients[i].QuantityBase" class="text-danger"></span>
                </td>
                <td><span class="base-unit-label text-muted"></span></td>
                <td><button class="btn btn-sm btn-outline-danger remove-row-button" type="button">Remove</button></td>
            </tr>
        }
        </tbody>
    </table>
    <div class="mb-3">
        <button class="btn btn-outline-primary" type="button" id="addIngredientButton">Add ingredient</button>
    </div>
    <button class="btn btn-primary" type="submit">Save recipe</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

<template id="ingredientRowTemplate">
    <tr class="ingredient-row">
        <td>
            <select class="form-select inventory-item-select">
                <option value="">Select item</option>
                @foreach (var item in inventoryItems)
                {
                    <option value="@item.Id" data-base-unit="@item.BaseUnit">@item.Name (@item.BaseUnit)</option>
                }
            </select>
        </td>
        <td><input class="form-control quantity-input" type="number" step="0.001" /></td>
        <td><span class="base-unit-label text-muted"></span></td>
        <td><button class="btn btn-sm btn-outline-danger remove-row-button" type="button">Remove</button></td>
    </tr>
</template>

@section Scripts {
    <script>
        (() => {
            const rows = document.getElementById('ingredientRows');
            const template = document.getElementById('ingredientRowTemplate');
            const outputItem = document.getElementById('outputItemSelect');
            const outputUnit = document.getElementById('outputUnitLabel');
            const outputWarning = document.getElementById('outputPreparedWarning');

            const updateOutputUnit = () => {
                const option = outputItem?.selectedOptions[0];
                outputUnit.textContent = option?.value ? option.dataset.baseUnit || '' : '';
                const isPrepared = option?.dataset.isPrepared === 'true';
                outputWarning.textContent = option?.value && !isPrepared ? 'Output item must be marked as a prepared item.' : '';
                outputWarning.classList.toggle('text-danger', Boolean(option?.value && !isPrepared));
            };

            const updateBaseUnitLabel = row => {
                const option = row.querySelector('.inventory-item-select')?.selectedOptions[0];
                row.querySelector('.base-unit-label').textContent = option?.value ? option.dataset.baseUnit || '' : '';
            };

            const refreshRowNames = () => {
                rows.querySelectorAll('.ingredient-row').forEach((row, index) => {
                    row.querySelector('.inventory-item-select').name = `Ingredients[${index}].InventoryItemId`;
                    row.querySelector('.quantity-input').name = `Ingredients[${index}].QuantityBase`;
                    row.querySelector('.remove-row-button').disabled = rows.querySelectorAll('.ingredient-row').length === 1;
                });
            };

            const wireRow = row => {
                row.querySelector('.inventory-item-select')?.addEventListener('change', () => updateBaseUnitLabel(row));
                row.querySelector('.remove-row-button')?.addEventListener('click', () => {
                    row.remove();
                    refreshRowNames();
                });
                updateBaseUnitLabel(row);
            };

            document.getElementById('addIngredientButton')?.addEventListener('click', () => {
                const row = template.content.firstElementChild.cloneNode(true);
                rows.appendChild(row);
                wireRow(row);
                refreshRowNames();
            });

            outputItem?.addEventListener('change', updateOutputUnit);
            rows.querySelectorAll('.ingredient-row').forEach(wireRow);
            updateOutputUnit();
            refreshRowNames();
        })();
    </script>
}
