@model IEnumerable<BranchPOS.Models.PreparationRecipe>
@{
    ViewData["Title"] = "Preparation Recipes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Preparation Recipes</h1>
    <div>
        <a class="btn btn-primary" asp-action="Edit">New recipe</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Output item</th><th>Output quantity</th><th>Ingredients</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var recipe in Model)
    {
        <tr>
            <td>@recipe.Name</td>
            <td>@recipe.OutputInventoryItem?.Name</td>
            <td>@recipe.OutputQuantityBase.ToString("0.###") @recipe.OutputInventoryItem?.BaseUnit</td>
            <td>@recipe.Ingredients.Count</td>
            <td>@(recipe.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@recipe.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
