@model IEnumerable<BranchPOS.Models.KitchenRequest>
@{
    ViewData["Title"] = "Kitchen Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kitchen Requests</h1>
    <a class="btn btn-primary" asp-action="Create">New request</a>
</div>

<div class="alert alert-info">
    Stock requests are recommendations until a stock manager dispatches them. Stock room inventory is deducted only when dispatch is confirmed.
</div>

@functions {
    private static decimal ToPurchaseQuantity(decimal baseQuantity, BranchPOS.Models.InventoryItem? item)
    {
        var factor = item?.DefaultConversionFactorToBase ?? 1m;
        return factor <= 0 ? baseQuantity : baseQuantity / factor;
    }

    private static string PurchaseUnit(BranchPOS.Models.InventoryItem? item) =>
        string.IsNullOrWhiteSpace(item?.PurchaseUnitName) ? item?.BaseUnit ?? "" : item.PurchaseUnitName!;

    private static string FormatQuantity(decimal baseQuantity, BranchPOS.Models.InventoryItem? item) =>
        $"{ToPurchaseQuantity(baseQuantity, item):0.###} {PurchaseUnit(item)}";
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Request</th>
            <th>Status</th>
            <th>Created</th>
            <th>Needed</th>
            <th>Stock Room</th>
            <th>Qty to Send</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var request in Model)
    {
        <tr>
            <td>
                <strong>@request.RequestNumber</strong>
                <div class="small">
                    <span class="badge @(request.RequestSource == BranchPOS.Models.KitchenRequestSource.Auto ? "text-bg-info" : "text-bg-secondary")">@request.RequestSource</span>
                    @if (request.AutoReason != BranchPOS.Models.KitchenRequestAutoReason.None)
                    {
                        <span class="badge text-bg-light">@request.AutoReason</span>
                    }
                </div>
            </td>
            <td>@request.Status</td>
            <td>
                Created @request.CreatedAt.ToLocalTime()
                @if (request.ApprovedAt.HasValue) { <div>Approved @request.ApprovedAt.Value.ToLocalTime()</div> }
                @if (request.DispatchedAt.HasValue) { <div>Dispatched @request.DispatchedAt.Value.ToLocalTime()</div> }
                <div class="small text-muted">@DateTime.Now.ToString("dddd, h:mm tt")</div>
            </td>
            <td>
                @foreach (var detail in request.Details)
                {
                    <div class="mb-2"><strong>@detail.InventoryItem?.Name</strong></div>
                }
            </td>
            <td>
                @foreach (var detail in request.Details)
                {
                    <div class="mb-2">
                        @ToPurchaseQuantity(detail.StockRoomAvailableAtRequest, detail.InventoryItem).ToString("0.###")
                        <span class="text-muted">@PurchaseUnit(detail.InventoryItem)</span>
                    </div>
                }
            </td>
            <td>
                @if (request.Status is BranchPOS.Models.KitchenRequestStatus.Pending or BranchPOS.Models.KitchenRequestStatus.PendingManagerReview or BranchPOS.Models.KitchenRequestStatus.Approved or BranchPOS.Models.KitchenRequestStatus.PartiallyDispatched)
                {
                    <form id="dispatch-@request.Id" asp-action="Dispatch" asp-route-id="@request.Id" method="post">
                        @foreach (var detail in request.Details)
                        {
                            var suggestedBase = detail.ApprovedQuantity ?? detail.RecommendedQuantity;
                            var suggestedPurchase = ToPurchaseQuantity(suggestedBase, detail.InventoryItem);
                            <div class="input-group input-group-sm mb-2">
                                <input name="quantitiesToSend[@detail.Id]" value="@suggestedPurchase.ToString("0.###")" class="form-control" type="number" min="0" step="0.001" />
                                <span class="input-group-text">@PurchaseUnit(detail.InventoryItem)</span>
                            </div>
                        }
                        <input name="managerNotes" class="form-control form-control-sm" placeholder="Notes (optional)" />
                    </form>
                }
                else if (request.Status is BranchPOS.Models.KitchenRequestStatus.Dispatched or BranchPOS.Models.KitchenRequestStatus.Received)
                {
                    @foreach (var detail in request.Details)
                    {
                        <div class="mb-2">@FormatQuantity(detail.DispatchedQuantity ?? detail.ApprovedQuantity ?? detail.RecommendedQuantity, detail.InventoryItem)</div>
                    }
                }
                else if (request.Status == BranchPOS.Models.KitchenRequestStatus.Rejected)
                {
                    @foreach (var detail in request.Details)
                    {
                        <div class="mb-2 text-muted">Rejected</div>
                    }
                }
                else if (request.Status == BranchPOS.Models.KitchenRequestStatus.Cancelled)
                {
                    @foreach (var detail in request.Details)
                    {
                        <div class="mb-2 text-muted">Cancelled</div>
                    }
                }
            </td>
            <td class="text-end">
                @if (request.Status is BranchPOS.Models.KitchenRequestStatus.Pending or BranchPOS.Models.KitchenRequestStatus.PendingManagerReview or BranchPOS.Models.KitchenRequestStatus.Approved or BranchPOS.Models.KitchenRequestStatus.PartiallyDispatched)
                {
                    <button class="btn btn-sm btn-primary mb-2" form="dispatch-@request.Id" type="submit">Dispatch</button>
                    <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
