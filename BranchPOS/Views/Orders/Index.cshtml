@model IEnumerable<BranchPOS.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Orders</h1>
    <a class="btn btn-primary" asp-action="Create">New order</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Order</th><th>Status</th><th>Type</th><th>Cashier</th><th>Customer</th><th>Date</th><th>Total</th><th>Items</th><th></th></tr></thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.OrderNumber</td>
            <td>@order.OrderStatus</td>
            <td>@order.OrderType</td>
            <td>@order.Cashier?.Email</td>
            <td>@order.Customer?.Name</td>
            <td>@order.CreatedAt.ToLocalTime()</td>
            <td>@CurrencyFormatter.Format(order.TotalAmount)</td>
            <td>@string.Join(", ", order.Items.Select(x => $"{x.ProductNameSnapshot} x{x.Quantity}"))</td>
            <td>
                @if (order.OrderStatus == BranchPOS.Models.OrderStatus.Completed)
                {
                    <a asp-action="Receipt" asp-route-id="@order.Id">Receipt</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
