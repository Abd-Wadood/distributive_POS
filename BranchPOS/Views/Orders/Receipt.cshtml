@model BranchPOS.Models.Order
@{
    ViewData["Title"] = "Receipt";
    var shouldAutoPrint = Context.Request.Query["print"] == "1";
    var receiptTime = (Model.CompletedAt ?? Model.CreatedAt).ToLocalTime().ToString("g");
}

<div class="receipt receipt-slip mx-auto">
    <div class="receipt-header">
        <h2>BranchPOS</h2>
        <div>@Model.OrderNumber</div>
        <div>@receiptTime</div>
    </div>

    <div class="receipt-meta">
        <div><span>Cashier</span><strong>@Model.Cashier?.Email</strong></div>
        <div><span>Type</span><strong>@Model.OrderType</strong></div>
        @if (Model.Customer is not null)
        {
            <div><span>Customer</span><strong>@Model.Customer.Name</strong></div>
            <div><span>Phone</span><strong>@Model.Customer.PhoneNumber</strong></div>
            <div><span>Address</span><strong>@Model.Customer.Address</strong></div>
        }
    </div>

    <div class="receipt-items">
        <div class="receipt-item receipt-item-head">
            <span>Item</span>
            <span>Qty</span>
            <span>Total</span>
        </div>
        @foreach (var item in Model.Items)
        {
            <div class="receipt-item">
                <span>
                    @item.ProductNameSnapshot
                    <small>@CurrencyFormatter.Format(item.UnitPrice) each</small>
                </span>
                <span>@item.Quantity</span>
                <span>@CurrencyFormatter.Format(item.LineTotal)</span>
            </div>
        }
    </div>

    <div class="receipt-totals">
        <div><span>Subtotal</span><strong>@CurrencyFormatter.Format(Model.Subtotal)</strong></div>
        <div><span>Discount</span><strong>@CurrencyFormatter.Format(Model.DiscountAmount)</strong></div>
        <div class="receipt-grand-total"><span>Total</span><strong>@CurrencyFormatter.Format(Model.TotalAmount)</strong></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p class="receipt-notes">@Model.Notes</p>
    }

    <div class="d-print-none mt-3 d-flex gap-2">
        <button class="btn btn-primary" onclick="window.print()">Print</button>
        <a class="btn btn-secondary" asp-action="Create">New order</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Orders</a>
    </div>
</div>

@if (shouldAutoPrint)
{
    <script>
        window.addEventListener('load', () => {
            window.setTimeout(() => window.print(), 250);
        });
    </script>
}
