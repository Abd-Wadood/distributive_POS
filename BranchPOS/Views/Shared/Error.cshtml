@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var message = Context.Request.Query["message"].FirstOrDefault();
    if (string.IsNullOrWhiteSpace(message))
    {
        message = "Something went wrong. Please try again. Contact administrator if the issue continues.";
    }

    var requestId = Context.Request.Query["requestId"].FirstOrDefault() ?? Model.RequestId;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Something went wrong</h1>
                <p class="text-muted mb-3">@message</p>
                <div class="alert alert-light border mb-3">
                    <div class="small text-muted">Request ID</div>
                    <code>@requestId</code>
                </div>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
                <button class="btn btn-outline-secondary" type="button" onclick="history.back()">Go back</button>
            </div>
        </div>
    </div>
</div>
