@using System.Security.Claims
@using BranchPOS.Models
@using Microsoft.EntityFrameworkCore
@inject BranchPOS.Data.AppDbContext DbContext
@inject BranchPOS.Services.ITerminalContextService TerminalContext
@{
    UserSession? layoutSession = null;
    Terminal? layoutTerminal = await TerminalContext.GetCurrentTerminalAsync();
    var layoutTerminalCode = layoutTerminal?.TerminalCode;
    if (User.Identity?.IsAuthenticated == true)
    {
        var layoutUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        layoutSession = await DbContext.UserSessions.Include(x => x.Branch)
            .Where(x => x.UserId == layoutUserId && (x.Status == SessionStatus.Active || x.Status == SessionStatus.Reopened))
            .OrderByDescending(x => x.StartedAt)
            .FirstOrDefaultAsync();
    }

    var isAdmin = User.IsInRole("Admin");
    var isCashier = User.IsInRole("Cashier") && !isAdmin;
    var isStockManager = User.IsInRole("StockManager") && !isAdmin;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BranchPOS</title>
    <script type="importmap"></script>
    @if (isAdmin)
    {
        <script>
            if (localStorage.getItem('BranchPOS.AdminTheme') === 'dark') {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        </script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BranchPOS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow app-navbar">
            <div class="container-fluid">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button id="sidebarToggle" class="btn btn-outline-secondary btn-sm me-2" type="button" aria-controls="appSidebar" aria-expanded="true">Menu</button>
                }
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BranchPOS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <button id="adminThemeToggle" class="btn btn-sm btn-outline-secondary me-2" type="button">Dark</button>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="navbar-text text-muted small me-3">
                                    @(layoutSession?.Branch?.Name ?? "No branch session") |
                                    @(layoutTerminal?.Name ?? layoutTerminalCode ?? "No terminal") |
                                    @User.Identity.Name |
                                    @(layoutSession?.RoleName ?? "No session")
                                    @if (layoutSession is not null)
                                    {
                                        <span>| @layoutSession.SessionCode</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="btn btn-link nav-link text-dark" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside id="appSidebar" class="app-sidebar border-end" aria-label="Main navigation">
                <div class="app-sidebar-header">
                    <div class="fw-semibold">
                        @(isAdmin ? "Admin" : isStockManager ? "Stock" : isCashier ? "Cashier" : "Menu")
                    </div>
                    <div class="text-muted small">Navigation</div>
                </div>
                <nav class="app-sidebar-nav">
                    <a class="app-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    @if (!isAdmin)
                    {
                        <a class="app-sidebar-link" asp-controller="Sessions" asp-action="Index">Session</a>
                    }
                    @if (isStockManager)
                    {
                        <div class="app-sidebar-label">Catalog</div>
                        <a class="app-sidebar-link" asp-controller="Products" asp-action="Index">Products</a>
                        <a class="app-sidebar-link" asp-controller="InventoryItems" asp-action="Index">Inventory Items</a>
                        <a class="app-sidebar-link" asp-controller="Recipes" asp-action="Index">Product Recipes</a>
                        <a class="app-sidebar-link" asp-controller="PreparationRecipes" asp-action="Index">Prepared Inventory</a>

                        <div class="app-sidebar-label">Stock</div>
                        <a class="app-sidebar-link" asp-controller="Purchases" asp-action="Index">Purchases</a>
                        <a class="app-sidebar-link" asp-controller="PreparedStock" asp-action="Add">Add Prepared</a>
                        <a class="app-sidebar-link" asp-controller="KitchenRequests" asp-action="Index">Kitchen Requests</a>
                        <a class="app-sidebar-link" asp-controller="InventoryAdjustments" asp-action="Index">Inventory Adjustments</a>
                        <a class="app-sidebar-link" asp-controller="InventoryReports" asp-action="StockRoom">Stock Room Inventory</a>
                        <a class="app-sidebar-link" asp-controller="InventoryReports" asp-action="Kitchen">Kitchen Inventory</a>
                        <a class="app-sidebar-link" asp-controller="InventoryReports" asp-action="Movements">Inventory Movements</a>

                        <div class="app-sidebar-label">Reports</div>
                        <a class="app-sidebar-link" asp-controller="InventoryReports" asp-action="Index">Inventory Reports</a>
                        <a class="app-sidebar-link" asp-controller="InventoryReports" asp-action="Profit">Profit Report</a>
                        <a class="app-sidebar-link" asp-controller="OperationalExpenses" asp-action="Index">Operational Expenses</a>
                    }
                    @if (isCashier)
                    {
                        <div class="app-sidebar-label">POS</div>
                        <a class="app-sidebar-link" asp-controller="Orders" asp-action="Create">Create Order</a>
                    }
                    @if (isAdmin)
                    {
                        <div class="app-sidebar-label">Administration</div>
                        <a class="app-sidebar-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        <a class="app-sidebar-link" asp-controller="Users" asp-action="Index">Users</a>
                        <a class="app-sidebar-link" asp-controller="Branches" asp-action="Index">Branches</a>
                        <a class="app-sidebar-link" asp-controller="Sessions" asp-action="PendingCloseApprovals">Session Approvals</a>
                        <a class="app-sidebar-link" asp-controller="Categories" asp-action="Index">Categories</a>
                        <a class="app-sidebar-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
                        <a class="app-sidebar-link" asp-controller="Terminals" asp-action="Index">Terminals</a>
                        <a class="app-sidebar-link" asp-controller="Reports" asp-action="Index">Reports</a>
                    }
                </nav>
            </aside>
        }
        <div class="app-content">
            <main role="main" class="container-fluid pb-3 pt-3">
                <partial name="_UserMessages" />
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BranchPOS
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (() => {
                const key = 'BranchPOS.SidebarCollapsed';
                const button = document.getElementById('sidebarToggle');
                const sidebar = document.getElementById('appSidebar');
                if (!button || !sidebar) return;

                const setCollapsed = collapsed => {
                    document.body.classList.toggle('sidebar-collapsed', collapsed);
                    button.setAttribute('aria-expanded', (!collapsed).toString());
                    button.textContent = collapsed ? 'Menu' : 'Close';
                    localStorage.setItem(key, collapsed ? 'true' : 'false');
                };

                setCollapsed(localStorage.getItem(key) === 'true');
                button.addEventListener('click', () => {
                    setCollapsed(!document.body.classList.contains('sidebar-collapsed'));
                });
            })();
        </script>
    }
    @if (isAdmin)
    {
        <script>
            (() => {
                const key = 'BranchPOS.AdminTheme';
                const button = document.getElementById('adminThemeToggle');
                const syncButton = () => {
                    if (!button) return;
                    const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                    button.textContent = dark ? 'Light' : 'Dark';
                    button.classList.toggle('btn-outline-light', dark);
                    button.classList.toggle('btn-outline-secondary', !dark);
                };

                syncButton();
                button?.addEventListener('click', () => {
                    const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                    if (dark) {
                        document.documentElement.removeAttribute('data-bs-theme');
                        localStorage.setItem(key, 'light');
                    } else {
                        document.documentElement.setAttribute('data-bs-theme', 'dark');
                        localStorage.setItem(key, 'dark');
                    }
                    syncButton();
                });
            })();
        </script>
    }
    @if (layoutSession is not null)
    {
        <form id="layoutAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>
        <script>
            setInterval(() => {
                const token = document.querySelector('#layoutAntiForgery input[name="__RequestVerificationToken"]')?.value;
                fetch('/Sessions/Heartbeat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: new URLSearchParams({ sessionId: '@layoutSession.Id', terminalName: '@layoutSession.TerminalName' })
                }).catch(() => {});
            }, 30000);
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
