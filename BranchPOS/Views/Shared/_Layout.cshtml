@using System.Security.Claims
@using BranchPOS.Models
@using Microsoft.EntityFrameworkCore
@inject BranchPOS.Data.AppDbContext DbContext
@inject BranchPOS.Services.ITerminalContextService TerminalContext
@{
    UserSession? layoutSession = null;
    Terminal? layoutTerminal = await TerminalContext.GetCurrentTerminalAsync();
    var layoutTerminalCode = layoutTerminal?.TerminalCode;
    if (User.Identity?.IsAuthenticated == true)
    {
        var layoutUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        layoutSession = await DbContext.UserSessions.Include(x => x.Branch)
            .Where(x => x.UserId == layoutUserId && (x.Status == SessionStatus.Active || x.Status == SessionStatus.Reopened))
            .OrderByDescending(x => x.StartedAt)
            .FirstOrDefaultAsync();
    }

    var isAdmin = User.IsInRole("Admin");
    var isCashier = User.IsInRole("Cashier") && !isAdmin;
    var isStockManager = User.IsInRole("StockManager") && !isAdmin;
    var navigationGroups = BuildNavigationGroups();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BranchPOS</title>
    <script type="importmap"></script>
    @if (isAdmin)
    {
        <script>
            if (localStorage.getItem('BranchPOS.AdminTheme') === 'dark') {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        </script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BranchPOS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow app-navbar">
            <div class="container-fluid">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button id="sidebarToggle" class="btn btn-outline-secondary btn-sm me-2" type="button" aria-controls="appSidebar" aria-expanded="true">Menu</button>
                }
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BranchPOS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <button id="adminThemeToggle" class="btn btn-sm btn-outline-secondary me-2" type="button">Dark</button>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="navbar-text text-muted small me-3">
                                    @(layoutSession?.Branch?.Name ?? "No branch session") |
                                    @(layoutTerminal?.Name ?? layoutTerminalCode ?? "No terminal") |
                                    @User.Identity.Name |
                                    @(layoutSession?.RoleName ?? "No session")
                                    @if (layoutSession is not null)
                                    {
                                        <span>| @layoutSession.SessionCode</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="btn btn-link nav-link text-dark" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside id="appSidebar" class="app-sidebar border-end" aria-label="Main navigation">
                <div class="app-sidebar-header">
                    <div>
                        <div class="app-sidebar-title">
                            @(isAdmin ? "Admin" : isStockManager ? "Stock" : isCashier ? "Cashier" : "Menu")
                        </div>
                        <div class="app-sidebar-subtitle">Workflow navigation</div>
                    </div>
                </div>
                <div class="app-sidebar-search">
                    <input id="sidebarSearch" class="form-control form-control-sm" type="search" placeholder="Search menu..." autocomplete="off" />
                </div>
                <nav id="sidebarNav" class="app-sidebar-nav">
                    @foreach (var group in navigationGroups)
                    {
                        var visibleItems = group.Items.Where(item => CanShowNavigationItem(item, User)).ToList();
                        if (visibleItems.Count == 0)
                        {
                            continue;
                        }

                        var groupActive = visibleItems.Any(item => IsNavigationItemActive(item, currentController, currentAction));
                        <section class="app-nav-group" data-nav-group data-group-key="@group.Key" data-group-title="@group.Title.ToLowerInvariant()" data-active-group="@groupActive.ToString().ToLowerInvariant()">
                            <button class="app-nav-group-toggle @(groupActive ? "is-active" : string.Empty)" type="button" aria-expanded="@groupActive.ToString().ToLowerInvariant()" title="@group.Title" data-nav-group-toggle>
                                <span class="app-nav-label">@group.Title</span>
                                <span class="app-nav-chevron" aria-hidden="true">›</span>
                            </button>
                            <div class="app-nav-group-items @(groupActive ? "is-open" : string.Empty)" data-nav-group-items>
                                @foreach (var item in visibleItems)
                                {
                                    var active = IsNavigationItemActive(item, currentController, currentAction);
                                    var url = Url.Action(item.Action, item.Controller) ?? "#";
                                    <a class="app-sidebar-link @(active ? "active" : string.Empty)" href="@url" title="@item.Label" data-nav-item data-menu-label="@item.Label.ToLowerInvariant()">
                                        <span class="app-nav-label">@item.Label</span>
                                    </a>
                                }
                            </div>
                        </section>
                    }
                </nav>
            </aside>
            <div id="sidebarOverlay" class="app-sidebar-overlay" hidden></div>
        }
        <div class="app-content">
            <main role="main" class="container-fluid pb-3 pt-3">
                <partial name="_UserMessages" />
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BranchPOS
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (() => {
                const compactKey = 'BranchPOS.SidebarCompact';
                const groupKey = 'BranchPOS.SidebarGroups';
                const button = document.getElementById('sidebarToggle');
                const sidebar = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const search = document.getElementById('sidebarSearch');
                const groups = Array.from(document.querySelectorAll('[data-nav-group]'));
                const mobileQuery = window.matchMedia('(max-width: 991px)');
                if (!button || !sidebar) return;

                const readGroupState = () => {
                    try {
                        return JSON.parse(localStorage.getItem(groupKey) || '{}');
                    } catch {
                        return {};
                    }
                };

                const writeGroupState = state => localStorage.setItem(groupKey, JSON.stringify(state));
                let groupState = readGroupState();

                const setGroupOpen = (group, open, persist = true) => {
                    const toggle = group.querySelector('[data-nav-group-toggle]');
                    const items = group.querySelector('[data-nav-group-items]');
                    group.classList.toggle('is-open', open);
                    items?.classList.toggle('is-open', open);
                    toggle?.setAttribute('aria-expanded', open.toString());
                    if (persist) {
                        groupState[group.dataset.groupKey] = open;
                        writeGroupState(groupState);
                    }
                };

                groups.forEach(group => {
                    const key = group.dataset.groupKey;
                    const hasStoredState = Object.prototype.hasOwnProperty.call(groupState, key);
                    const shouldOpen = group.dataset.activeGroup === 'true' || (hasStoredState ? groupState[key] === true : false);
                    setGroupOpen(group, shouldOpen, false);
                    group.querySelector('[data-nav-group-toggle]')?.addEventListener('click', () => {
                        setGroupOpen(group, !group.classList.contains('is-open'));
                    });
                });

                const closeMobileSidebar = () => {
                    document.body.classList.remove('sidebar-mobile-open');
                    overlay?.setAttribute('hidden', '');
                    button.setAttribute('aria-expanded', 'false');
                };

                const openMobileSidebar = () => {
                    document.body.classList.add('sidebar-mobile-open');
                    overlay?.removeAttribute('hidden');
                    button.setAttribute('aria-expanded', 'true');
                };

                const setCompact = compact => {
                    document.body.classList.toggle('sidebar-compact', compact);
                    localStorage.setItem(compactKey, compact ? 'true' : 'false');
                };

                const syncButton = () => {
                    if (mobileQuery.matches) {
                        const open = document.body.classList.contains('sidebar-mobile-open');
                        button.textContent = open ? 'Close' : 'Menu';
                        button.setAttribute('aria-expanded', open.toString());
                    } else {
                        const compact = document.body.classList.contains('sidebar-compact');
                        button.textContent = compact ? 'Expand' : 'Compact';
                        button.setAttribute('aria-expanded', (!compact).toString());
                        overlay?.setAttribute('hidden', '');
                        document.body.classList.remove('sidebar-mobile-open');
                    }
                };

                setCompact(localStorage.getItem(compactKey) === 'true');
                closeMobileSidebar();
                syncButton();

                button.addEventListener('click', () => {
                    if (mobileQuery.matches) {
                        if (document.body.classList.contains('sidebar-mobile-open')) {
                            closeMobileSidebar();
                        } else {
                            openMobileSidebar();
                        }
                    } else {
                        setCompact(!document.body.classList.contains('sidebar-compact'));
                    }
                    syncButton();
                });

                overlay?.addEventListener('click', () => {
                    closeMobileSidebar();
                    syncButton();
                });

                sidebar.querySelectorAll('[data-nav-item]').forEach(link => {
                    link.addEventListener('click', () => {
                        if (mobileQuery.matches) {
                            closeMobileSidebar();
                            syncButton();
                        }
                    });
                });

                search?.addEventListener('input', () => {
                    const query = search.value.trim().toLowerCase();
                    groups.forEach(group => {
                        const titleMatch = (group.dataset.groupTitle || '').includes(query);
                        const items = Array.from(group.querySelectorAll('[data-nav-item]'));
                        let childMatch = false;
                        items.forEach(item => {
                            const matches = !query || titleMatch || (item.dataset.menuLabel || '').includes(query);
                            item.classList.toggle('d-none', !matches);
                            childMatch = childMatch || matches;
                        });

                        const groupMatches = !query || titleMatch || childMatch;
                        group.classList.toggle('d-none', !groupMatches);
                        if (query && groupMatches) {
                            setGroupOpen(group, true, false);
                        } else if (!query) {
                            const key = group.dataset.groupKey;
                            const hasStoredState = Object.prototype.hasOwnProperty.call(groupState, key);
                            setGroupOpen(group, group.dataset.activeGroup === 'true' || (hasStoredState ? groupState[key] === true : false), false);
                        }
                    });
                });

                mobileQuery.addEventListener?.('change', syncButton);
            })();
        </script>
    }
    @if (isAdmin)
    {
        <script>
            (() => {
                const key = 'BranchPOS.AdminTheme';
                const button = document.getElementById('adminThemeToggle');
                const syncButton = () => {
                    if (!button) return;
                    const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                    button.textContent = dark ? 'Light' : 'Dark';
                    button.classList.toggle('btn-outline-light', dark);
                    button.classList.toggle('btn-outline-secondary', !dark);
                };

                syncButton();
                button?.addEventListener('click', () => {
                    const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                    if (dark) {
                        document.documentElement.removeAttribute('data-bs-theme');
                        localStorage.setItem(key, 'light');
                    } else {
                        document.documentElement.setAttribute('data-bs-theme', 'dark');
                        localStorage.setItem(key, 'dark');
                    }
                    syncButton();
                });
            })();
        </script>
    }
    @if (layoutSession is not null)
    {
        <form id="layoutAntiForgery" class="d-none">@Html.AntiForgeryToken()</form>
        <script>
            setInterval(() => {
                const token = document.querySelector('#layoutAntiForgery input[name="__RequestVerificationToken"]')?.value;
                fetch('/Sessions/Heartbeat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: new URLSearchParams({ sessionId: '@layoutSession.Id', terminalName: '@layoutSession.TerminalName' })
                }).catch(() => {});
            }, 30000);
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static IReadOnlyList<NavigationGroup> BuildNavigationGroups() =>
    [
        new NavigationGroup("dashboard", "Dashboard", "DB",
        [
            new NavigationItem("Home", "Home", "Index", "H"),
            new NavigationItem("Session", "Sessions", "Index", "S", ["Cashier", "StockManager"]),
            new NavigationItem("Create Order", "Orders", "Create", "O", ["Cashier"]),
            new NavigationItem("Session Approvals", "Sessions", "PendingCloseApprovals", "SA", ["Admin"])
        ]),
        new NavigationGroup("catalog", "Catalog", "CA",
        [
            new NavigationItem("Products", "Products", "Index", "P", ["StockManager"], ["Index", "Create", "Edit"]),
            new NavigationItem("Inventory Items", "InventoryItems", "Index", "II", ["StockManager"], ["Index", "Create", "Edit"]),
            new NavigationItem("Product Recipes", "Recipes", "Index", "R", ["StockManager"], ["Index", "Edit"]),
            new NavigationItem("Categories", "Categories", "Index", "C", ["Admin"]),
            new NavigationItem("Suppliers", "Suppliers", "Index", "S", ["Admin"])
        ]),
        new NavigationGroup("stock-operations", "Stock Operations", "SO",
        [
            new NavigationItem("Purchases", "Purchases", "Index", "PU", ["StockManager"], ["Index", "Create", "Details"]),
            new NavigationItem("Kitchen Requests", "KitchenRequests", "Index", "KR", ["StockManager"], ["Index", "Create", "Details"]),
            new NavigationItem("Manual Kitchen Usage", "ManualKitchenUsage", "Index", "MU", ["StockManager"]),
            new NavigationItem("Stock Counts", "StockCounts", "Index", "SC", ["StockManager"]),
            new NavigationItem("Inventory Adjustments", "InventoryAdjustments", "Index", "IA", ["StockManager"], ["Index", "Create", "Details", "WastageSummary"]),
            new NavigationItem("Order Correction", "InventoryManager", "OrderCorrection", "OC", ["StockManager", "Admin"])
        ]),
        new NavigationGroup("inventory-views", "Inventory Views", "IV",
        [
            new NavigationItem("Stock Room Inventory", "InventoryReports", "StockRoom", "SR", ["StockManager"]),
            new NavigationItem("Kitchen Inventory", "InventoryReports", "Kitchen", "KI", ["StockManager"]),
            new NavigationItem("Inventory Movements", "InventoryReports", "Movements", "MV", ["StockManager"])
        ]),
        new NavigationGroup("reports", "Reports", "RP",
        [
            new NavigationItem("Inventory Reports", "InventoryReports", "Index", "IR", ["StockManager"], ["Index", "ManualUsage", "PeriodicCountVariance", "RecipeConsumption"]),
            new NavigationItem("Profit Report", "InventoryReports", "Profit", "PR", ["StockManager"]),
            new NavigationItem("Operational Expenses", "OperationalExpenses", "Index", "OE", ["StockManager"], ["Index", "Create"]),
            new NavigationItem("Reports", "Reports", "Index", "R", ["Admin"])
        ]),
        new NavigationGroup("setup", "Setup", "ST",
        [
            new NavigationItem("Users", "Users", "Index", "U", ["Admin"], ["Index", "Create", "Edit"]),
            new NavigationItem("Branches", "Branches", "Index", "B", ["Admin"], ["Index", "Create", "Edit"]),
            new NavigationItem("Terminals", "Terminals", "Index", "T", ["Admin"], ["Index", "Create", "Edit"])
        ])
    ];

    private static bool CanShowNavigationItem(NavigationItem item, ClaimsPrincipal user) =>
        item.RequiredRoles.Count == 0 || item.RequiredRoles.Any(user.IsInRole);

    private static bool IsNavigationItemActive(NavigationItem item, string currentController, string currentAction)
    {
        if (!string.Equals(item.Controller, currentController, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.Equals(item.Action, currentAction, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return item.ActiveActions.Any(action => string.Equals(action, currentAction, StringComparison.OrdinalIgnoreCase));
    }

    private sealed record NavigationGroup(string Key, string Title, string Icon, IReadOnlyList<NavigationItem> Items);

    private sealed record NavigationItem(
        string Label,
        string Controller,
        string Action,
        string Icon,
        IReadOnlyList<string> RequiredRoles,
        IReadOnlyList<string> ActiveActions)
    {
        public NavigationItem(string label, string controller, string action, string icon)
            : this(label, controller, action, icon, [], [])
        {
        }

        public NavigationItem(string label, string controller, string action, string icon, IReadOnlyList<string> requiredRoles)
            : this(label, controller, action, icon, requiredRoles, [])
        {
        }
    }
}
