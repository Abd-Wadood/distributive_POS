@model BranchPOS.DTOs.CreateStockCountDto
@using BranchPOS.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Stock Counts";
    var items = (IEnumerable<SelectListItem>)ViewBag.InventoryItems;
    var recentCounts = (IEnumerable<StockCount>?)ViewBag.RecentCounts ?? [];
}

<h1>Stock Counts</h1>

<form asp-action="Create" method="post" class="mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-2">
            <label asp-for="CountDate" class="form-label">Date</label>
            <input asp-for="CountDate" class="form-control" type="date" />
        </div>
        <div class="col-md-2">
            <label asp-for="LocationType" class="form-label">Location</label>
            <select asp-for="LocationType" class="form-select" asp-items="Html.GetEnumSelectList<InventoryLocationType>()"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="InventoryItemId" class="form-label">Item</label>
            <select asp-for="InventoryItemId" asp-items="items" class="form-select">
                <option value="">Select item</option>
            </select>
            <span asp-validation-for="InventoryItemId" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="CountedQuantity" class="form-label">Counted quantity</label>
            <input asp-for="CountedQuantity" class="form-control" type="number" step="0.001" />
        </div>
        <div class="col-md-3">
            <label asp-for="Reason" class="form-label">Reason</label>
            <input asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Notes" class="form-label">Notes</label>
            <input asp-for="Notes" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Save count</button>
    </div>
</form>

<h2 class="h4">Recent counts</h2>
<table class="table table-sm align-middle">
    <thead>
    <tr>
        <th>Date</th>
        <th>Location</th>
        <th>Item</th>
        <th class="text-end">System</th>
        <th class="text-end">Counted</th>
        <th class="text-end">Difference</th>
        <th>Reason</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var count in recentCounts)
    {
        <tr>
            <td>@count.CountDate.ToString("yyyy-MM-dd")</td>
            <td>@count.LocationType</td>
            <td>@count.InventoryItem?.Name</td>
            <td class="text-end">@count.SystemQuantity.ToString("0.###")</td>
            <td class="text-end">@count.CountedQuantity.ToString("0.###")</td>
            <td class="text-end">@count.DifferenceQuantity.ToString("0.###")</td>
            <td>@count.Reason</td>
        </tr>
    }
    </tbody>
</table>
